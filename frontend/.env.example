# Insight frontend — environment configuration
#
# Copy this file to `.env.local` (git-ignored) before running the app.
# Next.js loads `.env.local` automatically in both `next dev` and `next build`.

# ---------------------------------------------------------------------------
# N8N_DIAGNOSE_WEBHOOK_URL
# ---------------------------------------------------------------------------
# The n8n webhook URL for the Insight diagnosis pipeline workflow (the public
# paste-and-diagnose entry point, FR-12 / PRD §6.6.1). The Next.js API route
# at /api/diagnose forwards requests here server-side — the browser never
# talks to this URL directly.
N8N_DIAGNOSE_WEBHOOK_URL=https://n8n.filheinzrelatorre.com/webhook/insight/diagnose

# ---------------------------------------------------------------------------
# N8N_WEBHOOK_SHARED_SECRET
# ---------------------------------------------------------------------------
# Sent as the `N8N_BEARER_TOKEN` header on every request /api/diagnose makes
# to the webhook above. n8n's Webhook node runs a Header Auth check
# (credential: "Insight - Shared Secret", header name `N8N_BEARER_TOKEN`) and
# rejects any request whose header value doesn't match — this is what stops
# the pipeline from being called directly, unauthenticated, and bypassing
# this app's rate limit (PRD §6.6.1 step 4).
#
# IMPORTANT: this value MUST be identical, byte-for-byte, to the "Value"
# field configured on that same n8n credential. If you rotate this secret,
# update it in BOTH places — your real .env.local (git-ignored, never this
# file) and the n8n credential — or every diagnosis request will start
# failing with an auth error at the n8n Webhook node.
#
# This is a TEMPLATE file and is committed to version control — never put
# a real secret value here. Generate your own with e.g.
# `openssl rand -hex 32` and put the real value only in `.env.local`.
N8N_WEBHOOK_SHARED_SECRET=replace-with-your-own-generated-secret

# ---------------------------------------------------------------------------
# N8N_MANAGE_INSTANCE_WEBHOOK_URL
# ---------------------------------------------------------------------------
# The n8n webhook URL for the "Insight - Manage Instance" workflow — the
# connect/revoke path behind /api/instances/connect and /api/instances/revoke
# (PRD §6.6 "Connecting or revoking an instance"). Same shared-secret header
# pattern as N8N_DIAGNOSE_WEBHOOK_URL above; N8N_WEBHOOK_SHARED_SECRET is
# reused for both, confirmed from the backend side.
N8N_MANAGE_INSTANCE_WEBHOOK_URL=https://n8n.filheinzrelatorre.com/webhook/insight/manage-instance

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) — OAuth sign-in for /dashboard/*
# ---------------------------------------------------------------------------
# MANUAL SETUP REQUIRED — none of the four values below can be filled in
# without registering an OAuth app with each provider first:
#
#   GitHub: https://github.com/settings/developers -> "New OAuth App"
#     Homepage URL:              http://localhost:3000 (or your deployed URL)
#     Authorization callback URL: http://localhost:3000/api/auth/callback/github
#
#   Google: https://console.cloud.google.com/apis/credentials
#     -> "Create Credentials" -> "OAuth client ID" -> "Web application"
#     Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#
# Leave these blank in this template; put the real values only in
# .env.local (git-ignored) or your hosting provider's env var settings.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# AUTH_SECRET encrypts/signs session JWTs and OAuth state — required.
# Generate one with: npx auth secret
# or:                 openssl rand -base64 32
# Never reuse the same value across environments (dev/staging/prod).
AUTH_SECRET=

# Base URL of this app. Auth.js v5 can usually infer this from the request
# (trustHost: true is set in src/lib/auth.ts), but some hosts/proxies need it
# stated explicitly — set it if sign-in redirects end up pointing at the
# wrong host.
NEXTAUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# DASHBOARD_DATABASE_URL
# ---------------------------------------------------------------------------
# A direct Postgres connection string for this Next.js app's own use:
#   (a) the Auth.js adapter's own tables (users/accounts/sessions/
#       verification_token) — see migrations/001_authjs_tables.sql, which
#       must be run manually once against this same database (the adapter
#       does not create these tables itself).
#   (b) reading `connected_instances` and `diagnoses` directly from Server
#       Components for the /dashboard pages (PRD §6.9 item 2).
#
# KNOWN SIMPLIFICATION vs. the PRD: §6.5/§6.9 call for the dashboard's own
# Postgres role to be strictly read-only, with n8n as the sole writer. This
# build uses a single connection string for both (a) and (b) instead of two
# separate roles, because (a) genuinely needs write access (creating a user
# row on first sign-in, etc.) and standing up a second role wasn't worth the
# ceremony at this project's stage. Nothing in this app's own code ever
# writes to connected_instances or diagnoses (see src/lib/dashboard-data.ts —
# SELECT only), but that boundary is enforced by convention here, not by a
# database permission. Flagging this rather than mislabeling the var
# "read-only" when it isn't.
#
# Same physical database as n8n's own Postgres credential (Neon), typically
# a different connection string/role if you do split it later.
DASHBOARD_DATABASE_URL=
